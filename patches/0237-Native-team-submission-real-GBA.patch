+bool NetPlayDialog::HasRealGba()
+{
+#ifdef ORRELINK_GBLINK
+  return Config::Get(Config::MAIN_GBLINK_JOYBUS) && GBLink::Manager::Get().JoyReadyCount() >= 1;
+#else
+  return false;
+#endif
+}
