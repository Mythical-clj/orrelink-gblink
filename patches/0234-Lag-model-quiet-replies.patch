 Source/Core/Core/HW/SI/JoyBusLagModel.h     | 59 ++++++++++++++++++++-
 Source/Core/Core/HW/SI/SI_DeviceGBALink.cpp |  8 +--
 4 files changed, 65 insertions(+), 5 deletions(-)

