From 4777bd0ff430f5125b6d5f696500e93aaba93056 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 18 Nov 2026 18:01:09 -0600
Subject: [PATCH] Ruby saves with stray data in the game-code field are
 detected by their money field; .fla saves can be picked

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01764cASb9aVVk2m6JupRMj5
---
 .../Core/DolphinQt/XDNetplay/XDLauncherDialog.cpp   |  2 +-
 Source/Core/UICommon/XDNetplay/Gen3Save.cpp         | 13 +++++++++++++
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/Source/Core/DolphinQt/XDNetplay/XDLauncherDialog.cpp b/Source/Core/DolphinQt/XDNetplay/XDLauncherDialog.cpp
index 2188bb7d0..01c559911 100644
--- a/Source/Core/DolphinQt/XDNetplay/XDLauncherDialog.cpp
+++ b/Source/Core/DolphinQt/XDNetplay/XDLauncherDialog.cpp
@@ -1431,7 +1431,7 @@ void XDLauncherDialog::OnImportSave(int device)
 {
   const QString path =
       QFileDialog::getOpenFileName(this, tr("Select a Gen 3 save file"), QString(),
-                                   tr("Gen 3 save files (*.sav *.sa2 *.srm);;All files (*)"));
+                                   tr("Gen 3 save files (*.sav *.sa2 *.srm *.fla *.dat);;All files (*)"));
   if (path.isEmpty())
     return;
 
diff --git a/Source/Core/UICommon/XDNetplay/Gen3Save.cpp b/Source/Core/UICommon/XDNetplay/Gen3Save.cpp
index 344a1e3b5..554b52f3f 100644
--- a/Source/Core/UICommon/XDNetplay/Gen3Save.cpp
+++ b/Source/Core/UICommon/XDNetplay/Gen3Save.cpp
@@ -119,6 +119,19 @@ Gen3Game EmeraldSave::DetectGame(const EmeraldSave& save)
     return Gen3Game::RubySapphire;
   if (code == 1)
     return Gen3Game::FireRedLeafGreen;
+
+  // Emerald keeps its security key in this field, but some Ruby saves have stray data here too.
+  // Emerald stores the money XORed with the key and Ruby/Sapphire store it plainly, so see which
+  // reading gives a believable amount (the game caps money at 999999).
+  const std::vector<u8> sec1 = save.SectionBytes(1);
+  if (sec1.size() >= 0x494)
+  {
+    constexpr size_t MONEY_OFFSET = 0x0490;
+    constexpr u32 MAX_MONEY = 999999;
+    const u32 raw = ReadU32(sec1.data(), MONEY_OFFSET);
+    if (raw <= MAX_MONEY && (raw ^ code) > MAX_MONEY)
+      return Gen3Game::RubySapphire;
+  }
   return Gen3Game::Emerald;
 }
 
