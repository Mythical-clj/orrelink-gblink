+// Gives the two chosen adapters ports 2 and 3 (the GBA sockets of a link battle) and switches
+// every other adapter off, so that each player's GBA answers on its own port.
+bool XDLauncherDialog::ApplyLocalPlayers()
+{
+#ifdef ORRELINK_GBLINK
+  const QString k1 = m_local_p1_combo->currentData().toString();
+  const QString k2 = m_local_p2_combo->currentData().toString();
+  if (k1.isEmpty() || k2.isEmpty() || k1 == k2)
+  {
+    m_local_status->setText(tr("Pick a different GB-Link for each player."));
+    return false;
+  }
+  for (const GBLink::AdapterInfo& a : GBLink::Manager::Get().GetAdapters())
+  {
+    const QString key = QString::fromStdString(a.key);
+    const int setting = key == k1 ? 2 : key == k2 ? 3 : -1;
+    GBLink::Manager::Get().SetPortSetting(a.key, setting);
+    QSettings().setValue(QStringLiteral("xdnetplay/gblink/port/%1").arg(key), setting);
+  }
+  QSettings().setValue(QStringLiteral("xdnetplay/gblink/local/p1"), k1);
+  QSettings().setValue(QStringLiteral("xdnetplay/gblink/local/p2"), k2);
+  return true;
+#else
+  return false;
+#endif
+}
+
+void XDLauncherDialog::OnBootLocalTwoPlayer()
+{
+#ifdef ORRELINK_GBLINK
+  if (GBLink::Manager::Get().GetAdapters().size() < 2)
+  {
+    ModalMessageBox::warning(this, tr("OrreLink"),
+                             tr("Two GB-Link adapters are needed. Plug in the second one."));
+    return;
+  }
+  if (XDNetplay::IsSoloMultiLaunch())
+  {
+    ModalMessageBox::warning(
+        this, tr("OrreLink"),
+        tr("Local 2-player uses ports 2 and 3. Turn off the Multi battle format first."));
+    return;
+  }
+  if (!ApplyLocalPlayers())
+  {
+    ModalMessageBox::warning(this, tr("OrreLink"),
+                             tr("Pick a different GB-Link for each player."));
+    return;
+  }
+  if (!Config::Get(Config::MAIN_GBLINK_JOYBUS))
+  {
+    // The adapters switch to JOY Bus mode a few seconds after this.
+    m_gblink_joybus_check->setChecked(true);
+    ModalMessageBox::information(
+        this, tr("OrreLink"),
+        tr("The GB-Links are switching to JOY Bus mode. Press the button again in a few seconds."));
+    return;
+  }
+  if (GBLink::Manager::Get().JoyReadyCount() < 2)
+  {
+    ModalMessageBox::warning(
+        this, tr("OrreLink"),
+        tr("Both GB-Links must be in JOY Bus mode (working firmware on both). Wait a few seconds, "
+           "or check the status above."));
+    return;
+  }
+  OnBootSolo();
+#endif
+}
