   Config::Save();
   return true;
 #endif
@@ -461,7 +470,25 @@ bool ImportTeamFromPartialSave(const std::string& partial_path, const std::strin
   const auto bundle = PartyBundle::Extract(*save, &parse_error);
   if (!bundle)
