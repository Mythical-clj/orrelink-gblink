 Source/Core/UICommon/UICommon.cpp                             | 2 +-
 7 files changed, 8 insertions(+), 8 deletions(-)
 rename Source/Core/InputCommon/GBLink/{Manager.cpp => GBLinkManager.cpp} (99%)
 rename Source/Core/InputCommon/GBLink/{Manager.h => GBLinkManager.h} (100%)

diff --git a/Source/Core/Core/HW/GBAPadEmu.cpp b/Source/Core/Core/HW/GBAPadEmu.cpp
index 1b942a16f..718bd2e77 100644
--- a/Source/Core/Core/HW/GBAPadEmu.cpp
+++ b/Source/Core/Core/HW/GBAPadEmu.cpp
@@ -11,7 +11,7 @@
