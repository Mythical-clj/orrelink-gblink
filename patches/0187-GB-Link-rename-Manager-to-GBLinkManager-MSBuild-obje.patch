---
 Source/Core/Core/HW/GBAPadEmu.cpp                             | 2 +-
 Source/Core/DolphinLib.props                                  | 4 ++--
 Source/Core/DolphinQt/XDNetplay/XDLauncherDialog.cpp          | 2 +-
 Source/Core/InputCommon/CMakeLists.txt                        | 4 ++--
 .../InputCommon/GBLink/{Manager.cpp => GBLinkManager.cpp}     | 2 +-
