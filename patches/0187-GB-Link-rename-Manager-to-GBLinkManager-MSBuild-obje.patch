 #if defined(__LIBUSB__) && !defined(ANDROID)
-#include "InputCommon/GBLink/Manager.h"
+#include "InputCommon/GBLink/GBLinkManager.h"
 #endif
 
 static const u16 dpad_bitmasks[] = {PAD_BUTTON_UP, PAD_BUTTON_DOWN, PAD_BUTTON_LEFT,
diff --git a/Source/Core/DolphinLib.props b/Source/Core/DolphinLib.props
index aee22b149..18de7143f 100644
--- a/Source/Core/DolphinLib.props
+++ b/Source/Core/DolphinLib.props
@@ -560,7 +560,7 @@
     <ClInclude Include="InputCommon\ControllerEmu\Setting\NumericSetting.h" />
     <ClInclude Include="InputCommon\ControllerEmu\StickGate.h" />
     <ClInclude Include="InputCommon\GBLink\GbaCartClient.h" />
-    <ClInclude Include="InputCommon\GBLink\Manager.h" />
+    <ClInclude Include="InputCommon\GBLink\GBLinkManager.h" />
     <ClInclude Include="InputCommon\GBLink\Multiboot.h" />
     <ClInclude Include="InputCommon\GBLink\Payloads.h" />
     <ClInclude Include="InputCommon\GBLink\Spi32.h" />
