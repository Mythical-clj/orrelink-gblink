+void XDLauncherDialog::RefreshGbLinkStatus()
+{
+#ifdef ORRELINK_GBLINK
+  const GBLink::Status status = GBLink::Manager::Get().GetStatus();
+  m_gblink_status->setText(QString::fromStdString(status.text));
+  // The pad checkbox mirrors the manager (the player can also release the GBA with the
+  // L+R+Start+Select combo, which turns the controller off inside the manager).
+  const bool enabled = GBLink::Manager::Get().IsControllerEnabled();
+  if (m_gblink_pad_check->isChecked() != enabled)
+  {
+    const QSignalBlocker blocker(m_gblink_pad_check);
+    m_gblink_pad_check->setChecked(enabled);
+  }
+  const bool busy = GBLink::Manager::Get().IsDumpQueued() ||
+                    status.state == GBLink::State::ReadingCart;
+  m_save_row_port2.gblink_button->setEnabled(!busy);
+  m_save_row_port3.gblink_button->setEnabled(!busy);
+#else
+  m_gblink_status->setText(tr("GB-Link support is not available in this build."));
+  m_gblink_pad_check->setEnabled(false);
+  m_save_row_port2.gblink_button->setEnabled(false);
+  m_save_row_port3.gblink_button->setEnabled(false);
+#endif
+}
+
+void XDLauncherDialog::OnImportFromGbLink(int device)
+{
+#ifdef ORRELINK_GBLINK
+  auto* progress = new QProgressDialog(tr("Starting..."), tr("Cancel"), 0, 100, this);
+  progress->setWindowTitle(tr("Reading your GBA cartridge"));
+  progress->setWindowModality(Qt::WindowModal);
+  progress->setMinimumDuration(0);
+  progress->setAutoClose(false);
+  progress->setAutoReset(false);
+  progress->setAttribute(Qt::WA_DeleteOnClose);
+  progress->setValue(0);
+
+  QPointer<QProgressDialog> progress_ptr(progress);
+  auto* label_timer = new QTimer(progress);
+  connect(label_timer, &QTimer::timeout, progress, [progress_ptr] {
+    if (progress_ptr)
+      progress_ptr->setLabelText(
+          QString::fromStdString(GBLink::Manager::Get().GetStatus().text));
+  });
+  label_timer->start(300);
+  connect(progress, &QProgressDialog::canceled, this, [] { GBLink::Manager::Get().CancelDump(); });
+
+  const bool queued = GBLink::Manager::Get().RequestDump(
+      [this, device](GBLink::DumpResult result) {
+        // Runs on the GB-Link thread. Keep a copy of the raw cartridge dump no matter what the
+        // import decides: the cartridge's own save is the one thing we cannot recreate.
+        std::string backup_path;
+        if (result.ok)
+        {
+          const std::string stamp =
+              QDateTime::currentDateTime().toString(QStringLiteral("yyyyMMdd-HHmmss")).toStdString();
+          backup_path = File::GetUserPath(D_USER_IDX) + "GBLink Dumps/" +
+                        (result.code.empty() ? std::string("GBA") : result.code) + "-" + stamp +
+                        ".sav";
+          File::CreateFullPath(backup_path);
+          File::IOFile file(backup_path, "wb");
+          if (!file.WriteBytes(result.save.data(), result.save.size()))
+          {
+            result.ok = false;
+            result.error = "Could not write the backup copy to " + backup_path;
+          }
+        }
+        QueueOnObject(this, [this, device, dump = std::move(result), backup_path,
+                             progress_ptr]() mutable {
+          if (progress_ptr)
+            progress_ptr->close();
+          if (!dump.ok)
+          {
+            if (dump.error != "Cancelled")
+            {
+              ModalMessageBox::warning(this, tr("OrreLink"),
+                                       QString::fromStdString(dump.error));
+            }
+            return;
+          }
+          std::string status;
+          std::string error;
+          if (!XDNetplay::SaveImport::ImportUserSave(backup_path, device, &status, &error))
+          {
+            ModalMessageBox::warning(
+                this, tr("OrreLink"),
+                tr("The save was read from the cartridge (%1) but could not be imported:\n\n%2\n\n"
+                   "A copy is kept at %3")
+                    .arg(QString::fromStdString(dump.title), QString::fromStdString(error),
+                         QString::fromStdString(backup_path)));
+          }
+          else
+          {
+            ModalMessageBox::information(
+                this, tr("OrreLink"),
+                tr("Read the save from %1.\n\n%2\n\nA backup copy of the raw cartridge save is "
+                   "kept at %3")
+                    .arg(QString::fromStdString(dump.title), QString::fromStdString(status),
+                         QString::fromStdString(backup_path)));
+          }
+          RefreshChecklist();
+        });
+      },
+      [progress_ptr](int percent) {
+        if (progress_ptr)
+          QueueOnObject(progress_ptr.data(), [progress_ptr, percent] {
+            if (progress_ptr)
+              progress_ptr->setValue(percent);
+          });
+      });
+  if (!queued)
+  {
+    progress->close();
+    ModalMessageBox::warning(this, tr("OrreLink"),
+                             tr("GB-Link is busy or not running. Try again in a moment."));
+  }
+#else
+  (void)device;
+  ModalMessageBox::warning(this, tr("OrreLink"),
+                           tr("GB-Link support is not available in this build."));
+#endif
+}
