+using Clock = std::chrono::steady_clock;
+void Sleep(int ms)
+{
+  std::this_thread::sleep_for(std::chrono::milliseconds(ms));
+}
+}  // namespace
+
+void GbaCartClient::CheckCancel()
+{
+  if (m_cancel || (m_ext_cancel && *m_ext_cancel))
+    throw GbaCartError("cancelled", "Cancelled");
+}
+
+std::vector<uint32_t> GbaCartClient::XferBatch(const std::vector<uint32_t>& words)
+{
+  auto r = Spi32Batch(m_usb, words);
+  if (!r)
+    throw GbaCartError("link", "USB read timeout - link lost?");
+  return *r;
+}
+
+void GbaCartClient::PollReady(int timeout_ms)
+{
+  const auto deadline = Clock::now() + std::chrono::milliseconds(timeout_ms);
+  while (Clock::now() < deadline)
+  {
+    CheckCancel();
+    const uint32_t w = Xfer(M_POLL);
+    if (w == G_READY)
+      return;
+    if (w == G_DONE)
+      Xfer(M_ABORT);
+    Sleep(25);
+  }
+  throw GbaCartError("timeout",
+                     "GBA dumper not responding. Is the payload running and the cable connected?");
+}
+
+bool GbaCartClient::Ping(int timeout_ms)
+{
+  try
+  {
+    PollReady(timeout_ms);
+    return true;
+  }
+  catch (const GbaCartError& e)
+  {
+    if (e.code == "cancelled")
+      throw;
+    return false;
+  }
+}
+
+void GbaCartClient::Command(uint32_t cmd)
+{
+  for (int attempt = 0; attempt < 5; attempt++)
+  {
+    CheckCancel();
+    PollReady(10000);
+    if (Xfer(M_MAGIC | cmd) != G_READY)
+      continue;
+    if (Xfer(M_GO) == uint32_t(~(M_MAGIC | cmd)))
+      return;
+  }
+  throw GbaCartError("desync", "Command handshake failed after retries");
+}
+
+void GbaCartClient::WaitDone(int timeout_ms)
+{
+  const auto started = Clock::now();
+  while (Clock::now() - started < std::chrono::milliseconds(timeout_ms))
+  {
+    CheckCancel();
+    const uint32_t w = Xfer(M_POLL);
+    if (w == G_DONE)
+    {
+      Xfer(M_CONT);
+      return;
+    }
+    if (w == G_READY)
+      throw GbaCartError("desync", "Payload returned to idle mid-operation");
+    Sleep(200);
+  }
+  throw GbaCartError("timeout", "Timed out waiting for the GBA");
+}
+
+std::vector<uint32_t> GbaCartClient::ReadWords(size_t n)
+{
+  return XferBatch(std::vector<uint32_t>(n, M_POLL));
+}
+
+std::vector<uint8_t> GbaCartClient::StreamIn(size_t total, const Progress& progress)
+{
+  std::vector<uint8_t> out(total);
+  const size_t sections = total / 0x100;
+  const std::vector<uint32_t> tx(SECTION_WORDS + 1, M_POLL);
+  int retries = 0;
+  for (size_t s = 0; s < sections;)
+  {
+    if (m_cancel || (m_ext_cancel && *m_ext_cancel))
+    {
+      Xfer(M_ABORT);
+      throw GbaCartError("cancelled", "Cancelled");
+    }
+    const auto resp = XferBatch(tx);
+    uint32_t xsum = 0;
+    for (size_t w = 0; w < SECTION_WORDS; w++)
+      xsum ^= resp[w];
+    if (xsum == resp[SECTION_WORDS])
+    {
+      for (size_t w = 0; w < SECTION_WORDS; w++)
+      {
+        const uint32_t v = resp[w];  // stored little-endian, as the GBA holds it
+        uint8_t* p = &out[s * 0x100 + w * 4];
+        p[0] = uint8_t(v);
+        p[1] = uint8_t(v >> 8);
+        p[2] = uint8_t(v >> 16);
+        p[3] = uint8_t(v >> 24);
+      }
+      Xfer(M_CONT);
+      s++;
+      retries = 0;
+      if (progress)
+        progress(s * 0x100, total);
+    }
+    else
+    {
+      if (++retries > 50)
+      {
+        Xfer(M_ABORT);
+        throw GbaCartError("checksum", "Section " + std::to_string(s) + " failed checksum 50 times");
+      }
+      Xfer(M_FAIL);
+    }
+  }
+  return out;
+}
+
+void GbaCartClient::EnterPadMode()
+{
+  Command(CMD_PAD);
+}
+
+bool GbaCartClient::PollPad(uint16_t* keys, uint32_t* raw_reply)
+{
+  const uint32_t w = Xfer(M_POLL);
+  if (raw_reply)
+    *raw_reply = w;
+  if ((w & 0xFFFF0000u) != PAD_MAGIC)
+    return false;
+  *keys = static_cast<uint16_t>(w & 0x03FF);
+  return true;
+}
+
+void GbaCartClient::LeavePadMode()
+{
+  Xfer(M_ABORT);
+  PollReady(3000);
+}
+
+CartInfo GbaCartClient::ReadInfo()
+{
+  Command(CMD_INFO);
+  WaitDone(60000);
+  const auto sizes = ReadWords(2);
+  CartInfo info;
+  if (sizes[0] == 0xFFFFFFFF)
+  {
+    info.no_cart = true;
+    return info;
+  }
+  info.game_size = sizes[0];
+  info.save_size = sizes[1];
+  const auto words = ReadWords(0xC0 / 4);
+  info.header.resize(0xC0);
+  for (size_t w = 0; w < words.size(); w++)
+    std::memcpy(&info.header[w * 4], &words[w], 4);  // host is little-endian (x86/ARM64)
+  const auto ascii = [&](size_t from, size_t len) {
+    std::string s;
+    for (size_t i = from; i < from + len; i++)
+    {
+      const uint8_t c = info.header[i];
+      if (c == 0)
+        break;
+      s += (c >= 0x20 && c < 0x7F) ? char(c) : '_';
+    }
+    return s;
+  };
+  info.title = ascii(0xA0, 12);
+  info.code = ascii(0xAC, 4);
+  info.maker = ascii(0xB0, 2);
+  return info;
+}
+
+std::vector<uint8_t> GbaCartClient::DumpSave(const Progress& progress)
+{
+  Command(CMD_DUMP_SAVE);
+  WaitDone(60000);
+  const auto sizes = ReadWords(2);
+  if (sizes[0] == 0xFFFFFFFF)
+    throw GbaCartError("no-cart", "No GBA cartridge detected");
+  if (sizes[1] == 0)
+    throw GbaCartError("no-save", "This cartridge has no save memory");
+  if (sizes[1] % 0x100 || sizes[1] > 0x20000)
+    throw GbaCartError("desync", "Implausible save size " + std::to_string(sizes[1]));
+  WaitDone(120000);
+  return StreamIn(sizes[1], progress);
+}
+}  // namespace GBLink
diff --git a/Source/Core/InputCommon/GBLink/GbaCartClient.h b/Source/Core/InputCommon/GBLink/GbaCartClient.h
new file mode 100644
index 000000000..425e75399
--- /dev/null
+++ b/Source/Core/InputCommon/GBLink/GbaCartClient.h
@@ -0,0 +1,71 @@
+// Client for the Cart Doctor GBA dumper payload once it is running on the GBA.
+// Port of the READ-ONLY parts of gba_cart.js (GB-Link/gb-cart-doctor-web, GPL-3.0).
+// Restore / erase / cart-run commands are deliberately NOT ported: this code can
+// never write to a cartridge.
+#pragma once
+#include <atomic>
+#include <cstdint>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include "InputCommon/GBLink/UsbLink.h"
+
+namespace GBLink
+{
+class GbaCartError : public std::runtime_error
+{
+public:
+  // timeout | no-cart | no-save | desync | checksum | cancelled | link
+  GbaCartError(std::string code, const std::string& msg) : std::runtime_error(msg), code(std::move(code)) {}
+  std::string code;
+};
+
+struct CartInfo
+{
+  bool no_cart = false;
+  uint32_t game_size = 0, save_size = 0;
+  std::string title, code, maker;
+  std::vector<uint8_t> header;  // 0xC0 bytes
+};
+
+class GbaCartClient
+{
+public:
+  using Progress = std::function<void(size_t done, size_t total)>;
+  GbaCartClient(UsbLink& usb, LogFn log) : m_usb(usb), m_log(std::move(log)) {}
+
+  void Cancel() { m_cancel = true; }
+  // Optional flag owned by the caller that also cancels (checked with the internal one).
+  void SetExternalCancel(const std::atomic<bool>* flag) { m_ext_cancel = flag; }
+  bool Ping(int timeout_ms = 3000);
+
+  // OrreLink agent only (orrelink-agent_mb.gba, not the stock Cart Doctor dumper).
+  // Controller mode: after EnterPadMode the GBA answers every exchange with its key
+  // state. Leave it with LeavePadMode before issuing any other command.
+  void EnterPadMode();
+  // One exchange. Returns false if the reply is not a key word (GBA left pad mode,
+  // wrong program, or a garbled word). keys: bit0 A, 1 B, 2 Select, 3 Start, 4 Right,
+  // 5 Left, 6 Up, 7 Down, 8 R, 9 L.
+  bool PollPad(uint16_t* keys, uint32_t* raw_reply = nullptr);
+  void LeavePadMode();
+  CartInfo ReadInfo();
+  // Dumps the cartridge save (EEPROM 512B/8K, SRAM 32K, Flash 64K/128K).
+  std::vector<uint8_t> DumpSave(const Progress& progress = {});
+
+private:
+  std::vector<uint32_t> XferBatch(const std::vector<uint32_t>& words);
+  uint32_t Xfer(uint32_t w) { return XferBatch({w})[0]; }
+  void PollReady(int timeout_ms);
+  void Command(uint32_t cmd);
+  void WaitDone(int timeout_ms);
+  std::vector<uint32_t> ReadWords(size_t n);
+  std::vector<uint8_t> StreamIn(size_t total_bytes, const Progress& progress);
+  void CheckCancel();
+
+  UsbLink& m_usb;
+  LogFn m_log;
+  std::atomic<bool> m_cancel{false};
+  const std::atomic<bool>* m_ext_cancel = nullptr;
+};
+}  // namespace GBLink
diff --git a/Source/Core/InputCommon/GBLink/Manager.cpp b/Source/Core/InputCommon/GBLink/Manager.cpp
new file mode 100644
index 000000000..8b9857aba
--- /dev/null
+++ b/Source/Core/InputCommon/GBLink/Manager.cpp
@@ -0,0 +1,408 @@
+// Copyright 2026 OrreLink contributors
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "InputCommon/GBLink/Manager.h"
+
+#include <chrono>
+#include <utility>
+
+#include "Common/Logging/Log.h"
+#include "InputCommon/GBLink/GbaCartClient.h"
+#include "InputCommon/GBLink/Multiboot.h"
+#include "InputCommon/GBLink/Payloads.h"
+#include "InputCommon/GBLink/Spi32.h"
+#include "InputCommon/GBLink/UsbLink.h"
+
+namespace GBLink
+{
+namespace
+{
+using Clock = std::chrono::steady_clock;
+
+constexpr int kDumpWaitForGbaSeconds = 90;
+constexpr int kDumpWaitForCartSeconds = 60;
+constexpr int kPadBadPollsBeforeCheck = 20;
+
+void LogLine(const std::string& s)
+{
+  INFO_LOG_FMT(CONTROLLERINTERFACE, "GBLink: {}", s);
+}
+}  // namespace
+
+Manager& Manager::Get()
+{
+  static Manager instance;
+  return instance;
+}
+
+Manager::~Manager()
+{
+  Stop();
+}
+
+void Manager::Start()
+{
+  std::lock_guard lock(m_mutex);
+  if (m_running)
+    return;
+  m_quit = false;
+  m_running = true;
+  m_status = {State::NoAdapter, "Looking for a GB-Link adapter..."};
+  m_thread = std::thread([this] { Run(); });
+}
+
+void Manager::Stop()
+{
+  {
+    std::lock_guard lock(m_mutex);
+    if (!m_running)
+      return;
+    m_quit = true;
+  }
+  m_cancel_dump = true;
+  m_cv.notify_all();
+  if (m_thread.joinable())
+    m_thread.join();
+  std::lock_guard lock(m_mutex);
+  m_running = false;
+  m_status = {State::Stopped, "GB-Link support stopped"};
+  m_pad_live = false;
+}
+
+Status Manager::GetStatus() const
+{
+  std::lock_guard lock(m_mutex);
+  return m_status;
+}
+
+void Manager::SetStatus(State state, std::string text)
+{
+  std::lock_guard lock(m_mutex);
+  if (m_status.state != state || m_status.text != text)
+    LogLine(text);
+  m_status = {state, std::move(text)};
+}
+
+bool Manager::GetPadKeys(uint16_t* keys) const
+{
+  if (!m_pad_live)
+    return false;
+  *keys = m_pad_keys;
+  return true;
+}
+
+void Manager::SetControllerEnabled(bool enabled)
+{
+  m_controller_enabled = enabled;
+  m_cv.notify_all();
+}
+
+bool Manager::RequestDump(std::function<void(DumpResult)> done, std::function<void(int)> progress)
+{
+  {
+    std::lock_guard lock(m_mutex);
+    if (m_dump || !m_running)
+      return false;
+    m_dump = std::make_unique<DumpRequest>();
+    m_dump->done = std::move(done);
+    m_dump->progress = std::move(progress);
+    m_cancel_dump = false;
+  }
+  m_cv.notify_all();
+  return true;
+}
+
+void Manager::CancelDump()
+{
+  m_cancel_dump = true;
+  m_cv.notify_all();
+}
+
+bool Manager::IsDumpQueued() const
+{
+  std::lock_guard lock(m_mutex);
+  return m_dump != nullptr;
+}
+
+void Manager::WaitFor(int ms)
+{
+  std::unique_lock lock(m_mutex);
+  m_cv.wait_for(lock, std::chrono::milliseconds(ms), [this] { return m_quit || m_dump; });
+}
+
+void Manager::Run()
+{
+  UsbLink usb;
+  usb.SetLog(LogLine);
+  std::unique_ptr<GbaCartClient> cart;
+  bool agent_loaded = false;
+  bool agent_has_pad = false;
+  bool pad_active = false;
+  int bad_polls = 0;
+
+  const auto quitting = [this] {
+    std::lock_guard lock(m_mutex);
+    return m_quit;
+  };
+  const auto take_dump = [this]() -> std::unique_ptr<DumpRequest> {
+    std::lock_guard lock(m_mutex);
+    return std::move(m_dump);
+  };
+  const auto dump_pending = [this] {
+    std::lock_guard lock(m_mutex);
+    return m_dump != nullptr;
+  };
+
+  const auto drop_adapter = [&] {
+    m_pad_live = false;
+    pad_active = false;
+    agent_loaded = false;
+    cart.reset();
+    usb.Close();
+  };
+
+  // Sends the OrreLink agent (or the stock dumper as a fallback) to a GBA that is waiting.
+  const auto load_agent = [&]() -> bool {
+    size_t size = 0;
+    const uint8_t* data = AgentPayload(&size);
+    agent_has_pad = size > 0;
+    if (!agent_has_pad)
+      data = DumperPayload(&size);
+    const std::vector<uint8_t> payload(data, data + size);
+    SetStatus(State::LoadingAgent, "Sending the OrreLink program to your GBA...");
+    std::string err;
+    if (!Multiboot(usb, payload, &err, LogLine, 5))
+    {
+      SetStatus(State::Error, "Could not load the GBA program: " + err);
+      return false;
+    }
+    cart = std::make_unique<GbaCartClient>(usb, LogLine);
+    cart->SetExternalCancel(&m_cancel_dump);
+    if (!cart->Ping(15000))
+    {
+      SetStatus(State::Error, "The GBA program did not answer after loading.");
+      cart.reset();
+      return false;
+    }
+    agent_loaded = true;
+    pad_active = false;
+    bad_polls = 0;
+    return true;
+  };
+
+  // Polls for the GBA's multiboot handshake. True if it is waiting for a program.
+  const auto gba_is_waiting = [&] { return (Spi32(usb, 0x6202) >> 16) == 0x7202; };
+
+  while (!quitting())
+  {
+    // ---- adapter -----------------------------------------------------------------------
+    if (!usb.IsOpen())
+    {
+      m_pad_live = false;
+      std::string err;
+      if (!usb.Open(&err))
+      {
+        if (auto req = take_dump())
+        {
+          DumpResult r;
+          r.error = "No GB-Link adapter found. Plug it in (and close the Cart Doctor browser tab).";
+          req->done(std::move(r));
+        }
+        SetStatus(State::NoAdapter, "No GB-Link adapter found");
+        WaitFor(1000);
+        continue;
+      }
+      if (!usb.IsNewFirmware())
+      {
+        SetStatus(State::Error, "This adapter has old firmware. Update it at launcher.gblink.io.");
+        usb.Close();
+        WaitFor(3000);
+        continue;
+      }
+      usb.DrainData();
+      usb.SetVoltage3V3();
+      usb.DrainData();
+      agent_loaded = false;
+      pad_active = false;
+      SetStatus(State::WaitingForGba, "GB-Link connected. Waiting for your GBA...");
+    }
+
+    try
+    {
+      // ---- cartridge dump request ------------------------------------------------------
+      if (dump_pending())
+      {
+        auto req = take_dump();
+        DumpResult result;
+        try
+        {
+          if (!agent_loaded)
+          {
+            SetStatus(State::WaitingForGba,
+                      "Power on your GBA now while holding START + SELECT (cartridge can stay in).");
+            const auto deadline = Clock::now() + std::chrono::seconds(kDumpWaitForGbaSeconds);
+            bool ok = false;
+            while (!quitting() && !m_cancel_dump && Clock::now() < deadline)
+            {
+              if (gba_is_waiting())
+              {
+                ok = load_agent();
+                break;
+              }
+              WaitFor(30);
+            }
+            if (!ok)
+            {
+              if (m_cancel_dump)
+                throw GbaCartError("cancelled", "Cancelled");
+              throw GbaCartError("timeout",
+                                 "The GBA never showed up. Power it on holding START + SELECT, "
+                                 "check the cable (small plug in the adapter), then try again.");
+            }
+          }
+          else if (pad_active)
+          {
+            m_pad_live = false;
+            cart->LeavePadMode();
+            pad_active = false;
+          }
+
+          SetStatus(State::ReadingCart, "Reading your cartridge...");
+          CartInfo info;
+          const auto cart_deadline = Clock::now() + std::chrono::seconds(kDumpWaitForCartSeconds);
+          while (true)
+          {
+            info = cart->ReadInfo();
+            if (!info.no_cart)
+              break;
+            SetStatus(State::ReadingCart,
+                      "No cartridge detected. Insert your cartridge into the GBA (leave it on).");
+            if (quitting() || m_cancel_dump || Clock::now() > cart_deadline)
+              throw GbaCartError("no-cart", "No cartridge was detected in the GBA.");
+            WaitFor(2000);
+          }
+          result.title = info.title;
+          result.code = info.code;
+          SetStatus(State::ReadingCart, "Reading the save from " + info.title + "...");
+          int last_pct = -1;
+          result.save = cart->DumpSave([&](size_t done, size_t total) {
+            const int pct = static_cast<int>(done * 100 / total);
+            if (pct != last_pct && req->progress)
+            {
+              last_pct = pct;
+              req->progress(pct);
+            }
+          });
+          result.ok = true;
+        }
+        catch (const GbaCartError& e)
+        {
+          result.ok = false;
+          result.error = e.what();
+          if (e.code == "link" || e.code == "desync" || e.code == "timeout")
+            agent_loaded = false;  // state unknown: ask for a fresh start
+        }
+        if (usb.Lost())
+          drop_adapter();
+        else
+          SetStatus(State::AgentIdle, result.ok ? "Cartridge read." : result.error);
+        if (req->done)
+          req->done(std::move(result));
+        continue;
+      }
+
+      // ---- controller ------------------------------------------------------------------
+      if (agent_loaded && agent_has_pad && m_controller_enabled)
+      {
+        if (!pad_active)
+        {
+          cart->EnterPadMode();
+          pad_active = true;
+          bad_polls = 0;
+          SetStatus(State::ControllerActive, "Your GBA is acting as a controller");
+        }
+        uint16_t keys = 0;
+        if (cart->PollPad(&keys))
+        {
+          bad_polls = 0;
+          m_pad_keys = keys;
+          m_pad_live = true;
+        }
+        else if (++bad_polls >= kPadBadPollsBeforeCheck)
+        {
+          m_pad_live = false;
+          m_pad_keys = 0;
+          pad_active = false;
+          if (cart->Ping(500))
+          {
+            // The GBA answers as an idle agent: the player pressed L+R+Start+Select.
+            m_controller_enabled = false;
+            SetStatus(State::AgentIdle, "GBA controller paused (L+R+Start+Select).");
+          }
+          else
+          {
+            agent_loaded = false;
+            SetStatus(State::WaitingForGba, "Lost the GBA. Power it on holding START + SELECT.");
+          }
+        }
+        if (usb.Lost())
+          drop_adapter();
+        else
+          WaitFor(1);
+        continue;
+      }
+
+      // ---- waiting for a GBA -----------------------------------------------------------
+      if (!agent_loaded)
+      {
+        if (m_controller_enabled)
+        {
+          if (gba_is_waiting())
+            load_agent();
+          else
+            SetStatus(State::WaitingForGba,
+                      "GB-Link connected. Power on your GBA holding START + SELECT "
+                      "(no cartridge needed) to use it as a controller.");
+          if (usb.Lost())
+            drop_adapter();
+          else
+            WaitFor(50);
+        }
+        else
+        {
+          SetStatus(State::WaitingForGba, "GB-Link connected (GBA controller is off).");
+          WaitFor(500);
+        }
+        continue;
+      }
+
+      // Agent running but nothing to do (controller off): idle without touching the link.
+      SetStatus(State::AgentIdle, "GBA program is running. Controller is off.");
+      WaitFor(250);
+    }
+    catch (const GbaCartError& e)
+    {
+      m_pad_live = false;
+      pad_active = false;
+      agent_loaded = false;
+      SetStatus(State::WaitingForGba, std::string("GBA link problem: ") + e.what());
+      if (usb.Lost())
+        drop_adapter();
+      WaitFor(500);
+    }
+  }
+
+  m_pad_live = false;
+  if (usb.IsOpen() && cart && pad_active)
+  {
+    try
+    {
+      cart->LeavePadMode();
+    }
+    catch (...)
+    {
+    }
+  }
+  usb.Close();
+}
+}  // namespace GBLink
diff --git a/Source/Core/InputCommon/GBLink/Manager.h b/Source/Core/InputCommon/GBLink/Manager.h
new file mode 100644
index 000000000..3b0578572
--- /dev/null
+++ b/Source/Core/InputCommon/GBLink/Manager.h
@@ -0,0 +1,105 @@
+// Copyright 2026 OrreLink contributors
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Owns the GB-Link USB adapter for the whole Dolphin process. One background thread:
+//  * finds the adapter (hot-plug),
+//  * when the GBA sits at its multiboot-wait screen, sends it the OrreLink agent,
+//  * keeps the GBA in controller mode and publishes its key state (read by GBAPad),
+//  * on request, pauses the controller and reads the cartridge save.
+// Nothing here ever writes to a cartridge.
+
+#pragma once
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace GBLink
+{
+enum class State
+{
+  Stopped,
+  NoAdapter,
+  WaitingForGba,   // adapter present, GBA not yet in multiboot-wait
+  LoadingAgent,
+  ControllerActive,
+  AgentIdle,       // agent running, controller paused (disabled, or no pad support)
+  ReadingCart,
+  Error,
+};
+
+struct Status
+{
+  State state = State::Stopped;
+  std::string text;
+};
+
+struct DumpResult
+{
+  bool ok = false;
+  std::string error;
+  std::vector<uint8_t> save;
+  std::string title;
+  std::string code;
+};
+
+class Manager
+{
+public:
+  static Manager& Get();
+
+  void Start();
+  void Stop();
+
+  Status GetStatus() const;
+
+  // Live controller state; false when no GBA is acting as a controller right now.
+  // keys: bit0 A, 1 B, 2 Select, 3 Start, 4 Right, 5 Left, 6 Up, 7 Down, 8 R, 9 L.
+  bool GetPadKeys(uint16_t* keys) const;
+
+  void SetControllerEnabled(bool enabled);
+  bool IsControllerEnabled() const { return m_controller_enabled; }
+
+  // Asynchronous, read-only cartridge save dump. |done| runs on the manager thread.
+  // |progress| gets 0-100. Returns false if a dump is already queued.
+  bool RequestDump(std::function<void(DumpResult)> done, std::function<void(int)> progress = {});
+  void CancelDump();
+  bool IsDumpQueued() const;
+
+private:
+  Manager() = default;
+  ~Manager();
+  Manager(const Manager&) = delete;
+  Manager& operator=(const Manager&) = delete;
+
+  struct DumpRequest
+  {
+    std::function<void(DumpResult)> done;
+    std::function<void(int)> progress;
+  };
+
+  void Run();
+  void SetStatus(State state, std::string text);
+  // Waits up to ms; returns early on quit or a queued dump.
+  void WaitFor(int ms);
+
+  mutable std::mutex m_mutex;
+  std::condition_variable m_cv;
+  std::thread m_thread;
+  bool m_quit = false;
+  bool m_running = false;
+  Status m_status;
+  std::unique_ptr<DumpRequest> m_dump;
+  std::atomic<bool> m_cancel_dump{false};
+
+  std::atomic<bool> m_controller_enabled{true};
+  std::atomic<bool> m_pad_live{false};
+  std::atomic<uint16_t> m_pad_keys{0};
+};
+}  // namespace GBLink
diff --git a/Source/Core/InputCommon/GBLink/Multiboot.cpp b/Source/Core/InputCommon/GBLink/Multiboot.cpp
new file mode 100644
index 000000000..7793b9ee8
--- /dev/null
+++ b/Source/Core/InputCommon/GBLink/Multiboot.cpp
@@ -0,0 +1,155 @@
+#include "InputCommon/GBLink/Multiboot.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <thread>
+
+#include "InputCommon/GBLink/Spi32.h"
+
+namespace GBLink
+{
+namespace
+{
+void Sleep(int ms)
+{
+  std::this_thread::sleep_for(std::chrono::milliseconds(ms));
+}
+
+void FoldCrc(uint32_t& crc, uint32_t word)
+{
+  for (int b = 0; b < 32; b++)
+  {
+    const uint32_t bit = (crc ^ word) & 1;
+    crc = (crc >> 1) ^ (bit ? 0xC37B : 0);
+    word >>= 1;
+  }
+}
+
+std::string H(uint32_t v)
+{
+  char b[16];
+  std::snprintf(b, sizeof(b), "0x%08x", v);
+  return b;
+}
+}  // namespace
+
+bool Multiboot(UsbLink& usb, const std::vector<uint8_t>& rom, std::string* error,
+               const LogFn& log, int wait_s)
+{
+  const auto fail = [&](const std::string& m) {
+    if (error)
+      *error = m;
+    return false;
+  };
+  if (rom.size() > 0x40000)
+    return fail("multiboot ROM larger than 256 KB");
+
+  size_t fsize = rom.size();
+  std::vector<uint8_t> padded(fsize + 0x10, 0);
+  std::copy(rom.begin(), rom.end(), padded.begin());
+
+  if (usb.IsNewFirmware())
+  {
+    usb.SetMode(MODE_GB_LINK);
+    Sleep(100);
+  }
+  if (!usb.SetTimingConfig(36, 4))
+    return fail("could not set timing (need new GB-Link firmware, VID 2FE3)");
+
+  log("Waiting for the GBA (it must be at the multiboot screen: no cart inserted, or hold START+SELECT at the logo)");
+  uint32_t recv = 0;
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(wait_s);
+  int attempts = 0;
+  do
+  {
+    const uint32_t raw = Spi32(usb, 0x6202);
+    recv = raw >> 16;
+    Sleep(10);
+    attempts++;
+    if (attempts <= 5 || attempts % 100 == 0)
+      log("SPI poll #" + std::to_string(attempts) + ": sent 0x6202, got " + H(raw));
+    if (std::chrono::steady_clock::now() > deadline)
+      return fail("timed out waiting for the GBA's multiboot handshake (0x7202)");
+  } while (recv != 0x7202);
+  log("GBA detected, starting transfer");
+
+  Spi32(usb, 0x6102);
+
+  std::vector<uint32_t> header;
+  for (size_t i = 0; i < 0xC0; i += 2)
+    header.push_back(padded[i] | (uint32_t(padded[i + 1]) << 8));
+  if (!Spi32Batch(usb, header))
+    return fail("header transfer failed");
+
+  Spi32(usb, 0x6200);
+  Spi32(usb, 0x6202);
+  Spi32(usb, 0x63D1);
+  const uint32_t token = Spi32(usb, 0x63D1);
+  if ((token >> 24) != 0x73)
+    return fail("handshake failed (got " + H(token) + ")");
+  log("Handshake ok");
+
+  uint32_t crc_a = (token >> 16) & 0xFF;
+  uint32_t seed = 0xFFFF00D1u | (crc_a << 8);
+  crc_a = (crc_a + 0x0F) & 0xFF;
+  Spi32(usb, 0x6400 | crc_a);
+
+  fsize = (fsize + 0x0F) & ~size_t(0x0F);
+  const uint32_t token2 = Spi32(usb, uint32_t((fsize - 0x190) / 4));
+  const uint32_t crc_b = (token2 >> 16) & 0xFF;
+  uint32_t crc_c = 0xC387;
+
+  log("Sending " + std::to_string(fsize) + " bytes");
+  int last_progress = -1;
+  for (size_t i = 0xC0; i < fsize;)
+  {
+    const size_t n = std::min(kBatchWords, (fsize - i) / 4);
+    std::vector<uint32_t> batch;
+    for (size_t w = 0; w < n; w++)
+    {
+      const size_t off = i + w * 4;
+      uint32_t dat = padded[off] | (uint32_t(padded[off + 1]) << 8) |
+                     (uint32_t(padded[off + 2]) << 16) | (uint32_t(padded[off + 3]) << 24);
+      FoldCrc(crc_c, dat);
+      seed = seed * 0x6F646573u + 1;
+      dat = seed ^ dat ^ (0xFE000000u - uint32_t(off)) ^ 0x43202F2Fu;
+      batch.push_back(dat);
+    }
+    const auto rx = Spi32Batch(usb, batch);
+    if (!rx)
+      return fail("USB read timeout during transfer at byte " + std::to_string(i));
+    for (size_t w = 0; w < n; w++)
+    {
+      const uint32_t off = uint32_t(i + w * 4);
+      const uint32_t chk = ((*rx)[w] >> 16) & 0xFFFF;
+      if (chk != (off & 0xFFFF))
+        return fail("transmission error at byte " + std::to_string(off));
+    }
+    i += n * 4;
+    const int progress = int(((i - 0xC0) * 10) / (fsize - 0xC0));
+    if (progress > last_progress)
+    {
+      log("Progress " + std::to_string(progress * 10) + "%");
+      last_progress = progress;
+    }
+  }
+
+  FoldCrc(crc_c, 0xFFFF0000u | (crc_b << 8) | crc_a);
+
+  Spi32(usb, 0x0065);
+  const auto ack_deadline = std::chrono::steady_clock::now() + std::chrono::seconds(10);
+  do
+  {
+    recv = Spi32(usb, 0x0065) >> 16;
+    Sleep(10);
+    if (std::chrono::steady_clock::now() > ack_deadline)
+      return fail("GBA never acknowledged the end of the transfer");
+  } while (recv != 0x0075);
+  Spi32(usb, 0x0066);
+  Spi32(usb, crc_c & 0xFFFF);
+  log("Multiboot complete");
+  Sleep(1000);
+  return true;
+}
+}  // namespace GBLink
