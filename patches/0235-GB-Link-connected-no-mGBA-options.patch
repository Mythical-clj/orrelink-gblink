From eab9f6a0cfe70a403f01c7022f0d12b4423109ab Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 20 Nov 2026 12:55:15 -0600
Subject: [PATCH] GB-Link connected: no mGBA options, trainers come from the
 cartridge

With a GB-Link found and "Real GBA" on, the launcher hides the mGBA section (ROMs, save imports,
team codes); the GB-Link settings that lived in it move to the Setup tab. Each real GBA port now
plays the trainer of its own cartridge, so one real GBA next to an integrated one works too.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01764cASb9aVVk2m6JupRMj5
---
 .../DolphinQt/XDNetplay/XDLauncherDialog.cpp     | 16 +++++++++++++++-
 .../Core/UICommon/XDNetplay/BattleCustomizer.cpp | 15 ++++++++-------
 2 files changed, 23 insertions(+), 8 deletions(-)

diff --git a/Source/Core/DolphinQt/XDNetplay/XDLauncherDialog.cpp b/Source/Core/DolphinQt/XDNetplay/XDLauncherDialog.cpp
index 8dddeab129..550dc66512 100644
--- a/Source/Core/DolphinQt/XDNetplay/XDLauncherDialog.cpp
+++ b/Source/Core/DolphinQt/XDNetplay/XDLauncherDialog.cpp
@@ -548,7 +548,8 @@ void XDLauncherDialog::CreateMainLayout()
   agent_layout->addWidget(m_gblink_full_read_check, 3, 0);
   agent_layout->setColumnStretch(0, 1);
   agent_box->setLayout(agent_layout);
-  mgba_layout->addWidget(agent_box);
+  // These are GB-Link settings (the adapters' ports among them), so they sit on the Setup tab
+  // below and stay when the mGBA section is hidden.
   {
     // Optional ROMs for the other Gen 3 games: a port that holds a FireRed/LeafGreen or
     // Ruby/Sapphire save then runs that game as it is, instead of an Emerald rebuild.
@@ -587,6 +588,7 @@ void XDLauncherDialog::CreateMainLayout()
   m_gblink_joybus_check->setChecked(Config::Get(Config::MAIN_GBLINK_JOYBUS));
   m_gblink_joybus_check->setToolTip(tr("Cartridge over JOY Bus"));
   gblink_layout->addWidget(m_gblink_joybus_check, 1, 0);
+  gblink_layout->addWidget(agent_box, 2, 0);
   gblink_layout->setColumnStretch(0, 1);
   gblink_box->setLayout(gblink_layout);
   // The GB-Link section has two tabs: the setup above, and two real GBAs played on this PC.
@@ -1508,6 +1510,18 @@ void XDLauncherDialog::RefreshGbLinkStatus()
 #ifdef ORRELINK_GBLINK
   const GBLink::Status status = GBLink::Manager::Get().GetStatus();
   m_gblink_status->setText(QString::fromStdString(status.text));
+  {
+    // A GB-Link with "Real GBA" on: the game reads everything from the cartridge, so the mGBA
+    // section (ROMs, save imports, team codes) is not offered at all. It comes back when the
+    // adapter is unplugged or "Real GBA" is turned off.
+    const bool real_gba =
+        Config::Get(Config::MAIN_GBLINK_JOYBUS) && !GBLink::Manager::Get().GetAdapters().empty();
+    if (m_mgba_toggle->isVisibleTo(this) == real_gba)
+    {
+      m_mgba_toggle->setVisible(!real_gba);
+      m_mgba_section->setVisible(!real_gba && m_mgba_toggle->isChecked());
+    }
+  }
   {
     // The Local 2-player tab: list the adapters by USB port, keep the player choices.
     const std::vector<GBLink::AdapterInfo> found = GBLink::Manager::Get().GetAdapters();
diff --git a/Source/Core/UICommon/XDNetplay/BattleCustomizer.cpp b/Source/Core/UICommon/XDNetplay/BattleCustomizer.cpp
index e19a9a132c..d858129c77 100644
--- a/Source/Core/UICommon/XDNetplay/BattleCustomizer.cpp
+++ b/Source/Core/UICommon/XDNetplay/BattleCustomizer.cpp
@@ -1279,14 +1279,15 @@ Selection ConfigSelection()
   // guest's own submission decides, so this stays out of it.
   if (sel.guest_model_fallback <= 0 && !IsNetplaySessionActive())
     sel.guest_model_fallback = SaveImport::CartridgeModelForDevice(2);
-  // Two real GBAs on this PC (the launcher's Local 2-player): each plays with its own cartridge's
-  // trainer, which the game takes from the GBA itself, so no model is forced on either side.
-  if (!IsNetplaySessionActive() &&
-      Config::Get(Config::GetInfoForSIDevice(1)) == SerialInterface::SIDEVICE_GC_GBA_GBLINK &&
-      Config::Get(Config::GetInfoForSIDevice(2)) == SerialInterface::SIDEVICE_GC_GBA_GBLINK)
+  // A real GBA on this PC (solo or the launcher's Local 2-player) plays with its own cartridge's
+  // trainer, which the game takes from the GBA itself, so no model is forced on that side. A port
+  // that is still an integrated GBA keeps its model.
+  if (!IsNetplaySessionActive())
   {
-    sel.host_model = 0;
-    sel.guest_model_fallback = 0;
+    if (Config::Get(Config::GetInfoForSIDevice(1)) == SerialInterface::SIDEVICE_GC_GBA_GBLINK)
+      sel.host_model = 0;
+    if (Config::Get(Config::GetInfoForSIDevice(2)) == SerialInterface::SIDEVICE_GC_GBA_GBLINK)
+      sel.guest_model_fallback = 0;
   }
   sel.music = Config::Get(Config::MAIN_XD_STYLE_MUSIC);
   sel.venue = Config::Get(Config::MAIN_XD_STYLE_VENUE);
-- 
