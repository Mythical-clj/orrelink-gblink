From c8044c2ea5f4a8368920b79fff0173e42b75365c Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Fri, 6 Nov 2026 13:11:16 -0600
Subject: [PATCH] GB-Link: stale cancel after a cartridge read, palette only
 with a real frame, wait diagnostics

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01764cASb9aVVk2m6JupRMj5
---
 .../Core/InputCommon/GBLink/GBLinkManager.cpp | 29 ++++++++++++++++++-
 .../Core/InputCommon/GBLink/GBLinkManager.h   |  1 +
 .../Core/InputCommon/GBLink/ScreenMirror.cpp  |  9 ++++--
 3 files changed, 35 insertions(+), 4 deletions(-)

diff --git a/Source/Core/InputCommon/GBLink/GBLinkManager.cpp b/Source/Core/InputCommon/GBLink/GBLinkManager.cpp
index 8493fa21c..4e9b7b03b 100644
--- a/Source/Core/InputCommon/GBLink/GBLinkManager.cpp
+++ b/Source/Core/InputCommon/GBLink/GBLinkManager.cpp
@@ -155,6 +155,13 @@ bool Link::RequestDump(std::function<void(DumpResult)> done, std::function<void(
 
 void Link::CancelDump()
 {
+  // A dialog that is merely closing after a finished read also lands here; that must not
+  // poison whatever the link does next.
+  {
+    std::lock_guard lock(m_mutex);
+    if (!m_dump && !m_dump_active)
+      return;
+  }
   m_cancel_dump = true;
   m_cv.notify_all();
 }
@@ -238,7 +245,13 @@ void Link::Run()
   };
 
   // Polls for the GBA's multiboot handshake. True if it is waiting for a program.
-  const auto gba_is_waiting = [&] { return (Spi32(usb, 0x6202) >> 16) == 0x7202; };
+  auto last_wait_log = Clock::now();
+  uint32_t last_wait_reply = 0;
+  const auto gba_is_waiting = [&] {
+    const uint32_t reply = Spi32(usb, 0x6202);
+    last_wait_reply = reply;
+    return (reply >> 16) == 0x7202;
+  };
 
   while (!quitting())
   {
@@ -289,6 +302,7 @@ void Link::Run()
       if (dump_pending())
       {
         auto req = take_dump();
+        m_dump_active = true;
         DumpResult result;
         try
         {
@@ -404,6 +418,8 @@ void Link::Run()
           drop_adapter();
         else
           SetStatus(State::AgentIdle, result.ok ? "Cartridge read." : result.error);
+        m_dump_active = false;
+        m_cancel_dump = false;
         if (req->done)
           req->done(std::move(result));
         continue;
@@ -522,9 +538,20 @@ void Link::Run()
           if (gba_is_waiting())
             load_agent();
           else
+          {
+            // Say now and then what the adapter sees, so a GBA that never shows up can be told
+            // apart from a cable or power problem (a GBA waiting for a program reads 0x7202xxxx).
+            if (Clock::now() - last_wait_log > std::chrono::seconds(15))
+            {
+              last_wait_log = Clock::now();
+              LogLine(fmt::format("still waiting for a GBA at the multiboot screen: the link reads "
+                                  "0x{:08x} (a waiting GBA reads 0x7202....)",
+                                  last_wait_reply));
+            }
             SetStatus(State::WaitingForGba,
                       "GB-Link connected. Power on your GBA holding START + SELECT "
                       "(no cartridge needed) to use it as a controller.");
+          }
           if (usb.Lost())
             drop_adapter();
           else
diff --git a/Source/Core/InputCommon/GBLink/GBLinkManager.h b/Source/Core/InputCommon/GBLink/GBLinkManager.h
index cd9d2dcdc..7d607bba9 100644
--- a/Source/Core/InputCommon/GBLink/GBLinkManager.h
+++ b/Source/Core/InputCommon/GBLink/GBLinkManager.h
@@ -112,6 +112,7 @@ private:
   Status m_status;
   std::unique_ptr<DumpRequest> m_dump;
   std::atomic<bool> m_cancel_dump{false};
+  std::atomic<bool> m_dump_active{false};
 
   std::atomic<bool> m_controller_enabled{true};
   std::atomic<int> m_port_setting{-2};
diff --git a/Source/Core/InputCommon/GBLink/ScreenMirror.cpp b/Source/Core/InputCommon/GBLink/ScreenMirror.cpp
index 304238242..50db30882 100644
--- a/Source/Core/InputCommon/GBLink/ScreenMirror.cpp
+++ b/Source/Core/InputCommon/GBLink/ScreenMirror.cpp
@@ -80,6 +80,7 @@ void ScreenMirror::Reset()
 {
   std::lock_guard lock(m_mutex);
   m_palette_sent = false;
+  m_have_frame = false;  // wait for a fresh frame before replacing what the GBA shows
   m_inflight = {};
   std::fill(m_sent.begin(), m_sent.end(), uint8_t(0xFF));  // matches nothing, so every tile differs
   m_cursor = 0;
@@ -92,6 +93,11 @@ bool ScreenMirror::NextPacket(std::vector<uint32_t>* words, size_t max_tiles)
   words->clear();
   m_inflight = {};
 
+  // Nothing is touched until there is a frame to show: sending the palette alone would recolour
+  // whatever the real GBA is displaying (the standby picture has its own palette).
+  if (!m_have_frame)
+    return false;
+
   if (!m_palette_sent)
   {
     // 256 colours * 2 bytes = 512 bytes = 8 chunks of 64 bytes.
@@ -110,9 +116,6 @@ bool ScreenMirror::NextPacket(std::vector<uint32_t>* words, size_t max_tiles)
     m_inflight.palette = true;
     return true;
   }
-  if (!m_have_frame)
-    return false;
-
   size_t found = 0;
   const size_t start = m_cursor;
   for (size_t n = 0; n < size_t(kTiles) && found < max_tiles; n++)
-- 
