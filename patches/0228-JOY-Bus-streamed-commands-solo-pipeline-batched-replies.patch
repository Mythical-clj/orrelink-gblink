@@ -397,35 +406,197 @@ void Link::RunJoybus(UsbLink& usb)
   uint64_t stat_ok = 0, stat_none = 0;
   double stat_ms = 0, stat_ms_max = 0;
 
+  // Several commands on their way to the adapter at once. A command is sent while the one before
+  // it is still being answered, so the USB turnaround of one overlaps the GBA's work on another
+  // (about half of a command's time otherwise). Each is numbered and its reply carries the number.
+  // First a test with harmless status commands: if the adapter does not answer four sent at once,
+  // each in order, it gets them one at a time as before.
+  size_t depth = 1;
+  {
+    usb.DrainData(20);
+    uint8_t first = 0;
+    for (int i = 0; i < 4; i++)
+    {
+      seq++;
+      if (i == 0)
+        first = seq;
+      if (!usb.SendCommand({CMD_JOY_TRANSFER, seq, 1, 3, 0x00}))
+        break;
+    }
+    int in_order = 0;
+    const auto until = Clock::now() + std::chrono::milliseconds(600);
+    uint8_t buf[64];
+    while (in_order < 4 && Clock::now() < until && !usb.Lost())
+    {
+      const size_t n = usb.ReadBytes(buf, sizeof(buf), 50);
+      if (n < 5 || buf[0] != CMD_JOY_TRANSFER)
+        continue;
+      if (buf[1] != static_cast<uint8_t>(first + in_order))
+        break;
+      in_order++;
+    }
+    if (in_order == 4)
+    {
+      depth = 4;
+      LogLine("JOY Bus: the adapter takes commands four at a time");
+    }
+    else
+    {
+      LogLine(fmt::format("JOY Bus: the adapter answered {} of 4 commands sent at once, in order; "
+                          "sending them one at a time",
+                          in_order));
+      usb.DrainData(100);
+    }
+  }
+
+  struct Out
+  {
+    JoyQueued q;
+    uint8_t seq = 0;
+    bool ready = false;  // not for the adapter (a placeholder, or one that could not be sent)
+    Clock::time_point sent;
+  };
+  std::deque<Out> out;
+  size_t real_out = 0;
+  uint8_t last_status[3] = {};
+  bool have_last_status = false;
+  auto last_flush = Clock::now();
+  bool unflushed = false;  // replies given to the sink, not yet flushed
+
+  const auto flush_replies = [&] {
+    if (unflushed)
+    {
+      if (const auto flush = s_reply_flush.load())
+        flush();
+    }
+    unflushed = false;
+    last_flush = Clock::now();
+  };
+  // Completes |e| (the front of the line) with |got| bytes in |rx|.
+  const auto finish = [&](const Out& e, int got, const uint8_t* rx) {
+    const JoyQueued& q = e.q;
+    uint8_t r[5] = {};
+    if (q.kind == 1)
+    {
+      got = have_last_status && q.rx_len == 3 ? 3 : -1;
+      if (got == 3)
+        std::copy(last_status, last_status + 3, r);
+    }
+    else if (q.kind == 2)
+    {
+      got = -1;
+    }
+    else
+    {
+      if (got != q.rx_len)
+        got = -1;  // a short reply is no reply, on every machine
+      if (got > 0)
+        std::copy(rx, rx + got, r);
+      if (q.is_status && got == 3)
+      {
+        std::copy(r, r + 3, last_status);
+        have_last_status = true;
+      }
+    }
+    const double ms =
+        e.ready ? 0.0 : std::chrono::duration<double, std::milli>(Clock::now() - e.sent).count();
+    bool abandoned;
+    {
+      std::lock_guard lock(m_mutex);
+      abandoned = m_joyq_abandoned.erase(q.id) != 0;
+    }
+    if (!abandoned)
+    {
+      // To the room before the caller can see the reply, so replies leave in order.
+      if (q.net_port >= 0)
+      {
+        if (const auto send = s_reply_send.load())
+        {
+          send(q.net_port, q.net_seq, got, r);
+          unflushed = true;
+        }
+      }
+      JoyQueuedResult result;
+      std::copy(r, r + 5, result.rx);
+      result.got = got;
+      result.usb_ms = ms;
+      {
+        std::lock_guard lock(m_mutex);
+        m_joyq_done[q.id] = result;
+      }
+      m_joy_cv.notify_all();
+    }
+    if (q.kind == 0)
