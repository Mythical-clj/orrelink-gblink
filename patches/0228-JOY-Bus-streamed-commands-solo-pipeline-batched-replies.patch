 // called from ---CPU--- thread
+// Replies are gathered and sent a few to a packet: a game's burst is thousands a second.
+// Callable from any thread.
+void NetPlayClient::QueueJoyReply(int port, u32 seq, int len, const u8* data)
+{
+  JoyOutEntry e;
+  e.port = static_cast<PadIndex>(port);
+  e.seq = seq;
+  e.len = static_cast<u8>(len > 0 ? len : 0xFF);
+  for (int i = 0; i < 5; i++)
+    e.data[i] = len > i ? data[i] : 0;
+  bool full;
+  {
+    std::lock_guard lk(m_joy_out_mutex);
+    m_joy_out.push_back(e);
+    full = m_joy_out.size() >= 8;
+  }
+  if (full)
+    FlushJoyReplies();
+}
+
+void NetPlayClient::FlushJoyReplies()
+{
+  std::vector<JoyOutEntry> out;
+  {
+    std::lock_guard lk(m_joy_out_mutex);
+    out.swap(m_joy_out);
+  }
+  // In order, one packet for each run of one port's replies.
+  size_t i = 0;
+  while (i < out.size())
+  {
+    size_t j = i;
+    while (j < out.size() && out[j].port == out[i].port && j - i < 255)
+      j++;
+    sf::Packet packet;
+    packet << MessageID::JoyReply << out[i].port << static_cast<u8>(j - i);
+    for (size_t k = i; k < j; k++)
+    {
+      packet << out[k].seq << out[k].len;
+      for (int b = 0; b < 5; b++)
+        packet << out[k].data[b];
+    }
+    SendAsync(std::move(packet));
+    i = j;
+  }
+}
