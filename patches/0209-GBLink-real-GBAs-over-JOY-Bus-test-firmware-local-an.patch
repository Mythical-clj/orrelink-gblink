+  m_joy_ready = false;
+  {
+    std::lock_guard lock(m_mutex);
+    if (m_joy.pending)
+    {
+      m_joy.pending = false;
+      m_joy.got = -1;
+      m_joy.done = true;
+    }
+  }
+  m_joy_cv.notify_all();
+  m_joy_device = -1;
