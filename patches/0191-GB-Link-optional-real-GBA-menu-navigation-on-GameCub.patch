From: Claude <noreply@anthropic.com>
Date: Thu, 5 Nov 2026 10:40:32 -0600
Subject: [PATCH] GB-Link: optional real-GBA menu navigation on GameCube pad
 port 1

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01764cASb9aVVk2m6JupRMj5
---
 Source/Core/Core/HW/GCPadEmu.cpp              | 46 ++++++++++++++++++-
 .../DolphinQt/XDNetplay/XDLauncherDialog.cpp  | 17 ++++++-
 .../DolphinQt/XDNetplay/XDLauncherDialog.h    |  1 +
 .../Core/InputCommon/GBLink/GBLinkManager.h   |  5 ++
 4 files changed, 67 insertions(+), 2 deletions(-)

diff --git a/Source/Core/Core/HW/GCPadEmu.cpp b/Source/Core/Core/HW/GCPadEmu.cpp
index dff79653c..aff13b0ed 100644
--- a/Source/Core/Core/HW/GCPadEmu.cpp
+++ b/Source/Core/Core/HW/GCPadEmu.cpp
@@ -17,6 +17,10 @@
 #include "InputCommon/ControllerEmu/StickGate.h"
 #include "InputCommon/GCPadStatus.h"
 
+#if defined(__LIBUSB__) && !defined(ANDROID)
+#include "InputCommon/GBLink/GBLinkManager.h"
+#endif
+
 static const u16 button_bitmasks[] = {
     PAD_BUTTON_A,
     PAD_BUTTON_B,
@@ -141,8 +145,33 @@ GCPadStatus GCPad::GetInput() const
   const auto lock = GetStateLock();
   GCPadStatus pad = {};
 
+#if defined(__LIBUSB__) && !defined(ANDROID)
+  // Optional: the real GBA (through GB-Link) can navigate menus as port 1's pad. Its key bits
+  // are in GBA order: A, B, Select, Start, Right, Left, Up, Down, R, L.
+  u16 gba_buttons = 0;
+  if (m_index == 0 && GBLink::Manager::Get().IsMenuNavigation())
+  {
+    u16 gba_keys = 0;
+    if (GBLink::Manager::Get().GetPadKeys(&gba_keys))
+    {
+      static constexpr u16 key_to_pad[10] = {PAD_BUTTON_A,     PAD_BUTTON_B,     PAD_TRIGGER_Z,
+                                             PAD_BUTTON_START, PAD_BUTTON_RIGHT, PAD_BUTTON_LEFT,
+                                             PAD_BUTTON_UP,    PAD_BUTTON_DOWN,  PAD_TRIGGER_R,
+                                             PAD_TRIGGER_L};
+      for (int i = 0; i < 10; i++)
+      {
+        if (gba_keys & (1 << i))
+          gba_buttons |= key_to_pad[i];
+      }
+    }
+  }
+  const bool gba_present = m_index == 0 && GBLink::Manager::Get().IsMenuNavigation();
+#else
+  const bool gba_present = false;
+#endif
+
   if (!(m_always_connected_setting.GetValue() || IsDefaultDeviceConnected() ||
-        m_input_override_function))
+        m_input_override_function || gba_present))
   {
     pad.isConnected = false;
     return pad;
@@ -178,6 +207,21 @@ GCPadStatus GCPad::GetInput() const
   pad.triggerLeft = MapFloat<u8>(triggers[0], 0);
   pad.triggerRight = MapFloat<u8>(triggers[1], 0);
 
+#if defined(__LIBUSB__) && !defined(ANDROID)
+  if (gba_buttons)
+  {
+    pad.button |= gba_buttons;
+    if (gba_buttons & PAD_BUTTON_A)
+      pad.analogA = 0xFF;
+    if (gba_buttons & PAD_BUTTON_B)
+      pad.analogB = 0xFF;
+    if (gba_buttons & PAD_TRIGGER_L)
+      pad.triggerLeft = 0xFF;
+    if (gba_buttons & PAD_TRIGGER_R)
+      pad.triggerRight = 0xFF;
+  }
+#endif
+
   return pad;
 }
 
diff --git a/Source/Core/DolphinQt/XDNetplay/XDLauncherDialog.cpp b/Source/Core/DolphinQt/XDNetplay/XDLauncherDialog.cpp
index 7b3cedfd7..f8f527f9a 100644
--- a/Source/Core/DolphinQt/XDNetplay/XDLauncherDialog.cpp
+++ b/Source/Core/DolphinQt/XDNetplay/XDLauncherDialog.cpp
@@ -424,6 +424,12 @@ void XDLauncherDialog::CreateMainLayout()
   m_gblink_full_read_check->setToolTip(
       tr("By default only your trainer info and team are read from the cartridge, which is much "
          "faster. Tick this to read and import the entire save instead."));
+  m_gblink_menu_check = new QCheckBox(tr("Also use my real GBA for XD menus (port 1)"));
+  m_gblink_menu_check->setChecked(false);
+  m_gblink_menu_check->setToolTip(
+      tr("The real GBA's buttons also act as the GameCube pad on port 1, so you can move through "
+         "XD's menus with it. Turn this off during link battles, where the GBA plays the "
+         "emulated Emerald instead."));
   m_gblink_pad_check = new QCheckBox(tr("Use my real GBA as the controller"));
   m_gblink_pad_check->setChecked(true);
   m_gblink_pad_check->setToolTip(
@@ -433,7 +439,8 @@ void XDLauncherDialog::CreateMainLayout()
          "release it."));
   gblink_layout->addWidget(m_gblink_status, 0, 0);
   gblink_layout->addWidget(m_gblink_pad_check, 1, 0);
-  gblink_layout->addWidget(m_gblink_full_read_check, 2, 0);
+  gblink_layout->addWidget(m_gblink_menu_check, 2, 0);
+  gblink_layout->addWidget(m_gblink_full_read_check, 3, 0);
   gblink_layout->setColumnStretch(0, 1);
   gblink_box->setLayout(gblink_layout);
   layout->addWidget(gblink_box);
@@ -906,6 +913,13 @@ void XDLauncherDialog::ConnectWidgets()
     GBLink::Manager::Get().SetControllerEnabled(on);
 #else
     (void)on;
+#endif
+  });
+  connect(m_gblink_menu_check, &QCheckBox::toggled, this, [](bool on) {
+#ifdef ORRELINK_GBLINK
+    GBLink::Manager::Get().SetMenuNavigation(on);
+#else
+    (void)on;
 #endif
   });
   m_gblink_timer = new QTimer(this);
@@ -1230,6 +1244,7 @@ void XDLauncherDialog::RefreshGbLinkStatus()
 #else
   m_gblink_status->setText(tr("GB-Link support is not available in this build."));
   m_gblink_pad_check->setEnabled(false);
+  m_gblink_menu_check->setEnabled(false);
   m_save_row_port2.gblink_button->setEnabled(false);
   m_save_row_port3.gblink_button->setEnabled(false);
 #endif
diff --git a/Source/Core/DolphinQt/XDNetplay/XDLauncherDialog.h b/Source/Core/DolphinQt/XDNetplay/XDLauncherDialog.h
index 850bf4bb0..312792b00 100644
--- a/Source/Core/DolphinQt/XDNetplay/XDLauncherDialog.h
+++ b/Source/Core/DolphinQt/XDNetplay/XDLauncherDialog.h
@@ -129,6 +129,7 @@ private:
 
   QLabel* m_gblink_status = nullptr;
   QCheckBox* m_gblink_full_read_check = nullptr;
+  QCheckBox* m_gblink_menu_check = nullptr;
   QCheckBox* m_gblink_pad_check = nullptr;
   QTimer* m_gblink_timer = nullptr;
 
diff --git a/Source/Core/InputCommon/GBLink/GBLinkManager.h b/Source/Core/InputCommon/GBLink/GBLinkManager.h
index 1f829afc9..09def2b29 100644
--- a/Source/Core/InputCommon/GBLink/GBLinkManager.h
+++ b/Source/Core/InputCommon/GBLink/GBLinkManager.h
@@ -68,6 +68,10 @@ public:
   void SetControllerEnabled(bool enabled);
   bool IsControllerEnabled() const { return m_controller_enabled; }
 
+  // When on, the real GBA's buttons also drive the GameCube pad on port 1 (menu navigation).
+  void SetMenuNavigation(bool on) { m_menu_nav = on; }
+  bool IsMenuNavigation() const { return m_menu_nav; }
+
   // Asynchronous, read-only cartridge save dump. |done| runs on the manager thread.
   // |progress| gets 0-100. Returns false if a dump is already queued.
   // team_only: read just the Gen 3 trainer + party sections when the OrreLink agent is running
@@ -106,6 +110,7 @@ private:
 
   std::atomic<bool> m_controller_enabled{true};
   std::atomic<bool> m_pad_live{false};
+  std::atomic<bool> m_menu_nav{false};
   std::atomic<uint16_t> m_pad_keys{0};
   mutable std::atomic<uint64_t> m_query_count{0};
   mutable std::atomic<uint64_t> m_query_live{0};
